// SULAP (Suka Lapor) - skema database
// Target: PostgreSQL 17 di Supabase
// Sumber kebenaran tabel: prd-sulap.md bagian 18 dan docs/supabase.md
// Aturan: semua tabel domain memakai RLS. service_role hanya untuk operasi server tervalidasi.

Project sulap {
  database_type: 'PostgreSQL'
  Note: '''
  Skema MVP satu RT dengan kesiapan multi-RT.
  - Semua waktu memakai timestamptz dan disimpan dalam UTC.
  - Penghapusan laporan hanya soft delete (deleted_at) dan hanya oleh developer.
  - report_status_history dan audit_logs bersifat append-only.
  - Nomor publik laporan dibuat atomik dari rts.report_seq.
  '''
}

Enum member_role {
  resident
  rt_admin
  developer
  officer // P2, penugasan petugas
}

Enum membership_status {
  pending
  active
  rejected
  suspended
  left
}

Enum join_method {
  invite_code
  request
}

Enum report_status_group {
  new
  triaged
  inspection
  in_progress
  resolved
  closed
  reopened
}

Enum location_source {
  gps
  map_pin
  manual
}

Enum attachment_kind {
  report_evidence
  inspection
  resolution
}

Enum moderation_status {
  visible
  hidden
  removed
}

Enum notification_type {
  report_created
  report_status_changed
  report_comment
  report_reopened
  membership_requested
  membership_decided
  assignment_created
}

Enum assignment_status {
  assigned
  in_progress
  done
  cancelled
}

// Dikelola Supabase Auth. Tidak dibuat oleh migrasi aplikasi.
Table auth.users {
  id uuid [pk]
  email varchar
  Note: 'Tabel internal Supabase Auth. Aplikasi hanya membaca id lewat profil.'
}

Table profiles {
  id uuid [pk, note: 'Sama dengan auth.users.id']
  display_name varchar(80) [not null]
  avatar_path text [note: 'Path Supabase Storage, bukan URL publik']
  locale varchar(10) [not null, default: 'id-ID']
  last_seen_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Profil minimum. Email tetap di auth.users dan tidak diekspos ke warga lain. RLS: pengguna membaca profil sendiri, admin RT membaca profil anggota RT-nya lewat view terbatas.'
}

Table rts {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(120) [not null]
  slug varchar(60) [not null, unique]
  rw_name varchar(120)
  address_text text
  report_prefix varchar(12) [not null, unique, note: 'Contoh: RT01']
  report_seq integer [not null, default: 0, note: 'Counter nomor laporan, dinaikkan atomik di fungsi create_report']
  photo_required boolean [not null, default: true]
  max_photos smallint [not null, default: 5, note: 'check 1..5']
  timezone varchar(50) [not null, default: 'Asia/Jakarta']
  is_active boolean [not null, default: true]
  created_by uuid [ref: > profiles.id, note: 'Developer pembuat RT']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    slug [unique, name: 'uq_rts_slug']
    (is_active, name) [name: 'idx_rts_active_name']
  }

  Note: 'Tenant utama. Semua data domain membawa rt_id. RLS: anggota aktif hanya melihat RT-nya sendiri.'
}

Table rt_invite_codes {
  id uuid [pk, default: `gen_random_uuid()`]
  rt_id uuid [not null, ref: > rts.id]
  code_hash text [not null, unique, note: 'SHA-256 dari kode. Kode mentah hanya ditampilkan sekali']
  label varchar(80)
  max_uses smallint [not null, default: 50]
  uses_count smallint [not null, default: 0]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_by uuid [not null, ref: > profiles.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (rt_id, created_at) [name: 'idx_invite_rt_created']
  }

  Note: 'Kode undangan RT. Rotasi membuat baris baru dan merevoke yang lama. check uses_count <= max_uses. RLS: hanya admin RT dan developer.'
}

Table memberships {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > profiles.id]
  rt_id uuid [not null, ref: > rts.id]
  role member_role [not null, default: 'resident']
  status membership_status [not null, default: 'pending']
  join_method join_method [not null]
  invite_code_id uuid [ref: > rt_invite_codes.id]
  request_note varchar(300)
  decided_by uuid [ref: > profiles.id]
  decided_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, rt_id) [unique, name: 'uq_membership_user_rt', note: 'Partial unique index WHERE status IN (pending, active)']
    (rt_id, status, role) [name: 'idx_membership_rt_status']
    (decided_by) [name: 'idx_membership_decided_by']
  }

  Note: 'Satu pengguna satu RT pada MVP. Unik parsial mencegah pengajuan ganda saat pending atau active. RLS: pengguna melihat keanggotaan sendiri; admin RT melihat semua anggota RT-nya.'
}

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  rt_id uuid [not null, ref: > rts.id]
  name varchar(60) [not null]
  slug varchar(60) [not null]
  description varchar(200)
  sort_order smallint [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (rt_id, slug) [unique, name: 'uq_category_rt_slug']
    (rt_id, is_active, sort_order) [name: 'idx_category_rt_active']
  }

  Note: 'Kategori per RT. Nonaktif tidak menghapus relasi laporan lama. RLS: anggota RT membaca, admin RT menulis.'
}

Table status_definitions {
  id uuid [pk, default: `gen_random_uuid()`]
  rt_id uuid [not null, ref: > rts.id]
  group report_status_group [not null]
  label varchar(40) [not null, note: 'Label yang dilihat pengguna']
  color_hex char(7) [not null, note: 'check format #RRGGBB']
  sort_order smallint [not null, default: 0]
  requires_note boolean [not null, default: false, note: 'true untuk resolved dan closed']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (rt_id, group) [unique, name: 'uq_status_rt_group']
    (rt_id, is_active, sort_order) [name: 'idx_status_rt_active']
  }

  Note: 'Satu label aktif per kelompok internal per RT. Kelompok internal tidak dapat diubah. RLS: anggota membaca, admin RT mengubah label/warna/urutan dan menonaktifkan yang tidak terpakai.'
}

Table reports {
  id uuid [pk, default: `gen_random_uuid()`]
  public_no varchar(24) [not null, unique, note: 'Contoh: SULAP-RT01-0001']
  rt_id uuid [not null, ref: > rts.id]
  category_id uuid [not null, ref: > categories.id]
  reporter_id uuid [not null, ref: > profiles.id]
  title varchar(120) [not null]
  description varchar(2000) [not null]
  current_status_id uuid [not null, ref: > status_definitions.id]
  current_status_group report_status_group [not null, default: 'new', note: 'Denormalisasi dari status_definitions.group, dijaga trigger']
  latitude numeric(9,6) [note: 'Presisi disimpan; warga lain hanya melihat 3 desimal']
  longitude numeric(9,6)
  accuracy_m numeric(6,1)
  location_source location_source [not null]
  location_text varchar(200)
  location_note varchar(200)
  resolution_summary text [note: 'Wajib saat status resolved']
  closure_reason varchar(300) [note: 'Wajib saat status closed']
  resolved_at timestamptz
  closed_at timestamptz
  deleted_at timestamptz [note: 'Soft delete oleh developer']
  deleted_by uuid [ref: > profiles.id]
  delete_reason varchar(300)
  version integer [not null, default: 1, note: 'Optimistic concurrency untuk update admin']
  search_tsv tsvector [note: 'Generated column dengan konfigurasi simple, index GIN']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (rt_id, created_at) [name: 'idx_reports_rt_created']
    (rt_id, current_status_group, created_at) [name: 'idx_reports_rt_status']
    (rt_id, category_id, created_at) [name: 'idx_reports_rt_category']
    (reporter_id, created_at) [name: 'idx_reports_reporter']
    (deleted_at) [name: 'idx_reports_deleted']
    search_tsv [name: 'idx_reports_search', type: gin]
  }

  Note: 'Laporan tidak pernah dihapus keras oleh admin. check: latitude -90..90, longitude -180..180, length(trim(title)) > 0. RLS: anggota RT membaca laporan yang tidak deleted; admin RT membaca semua termasuk yang soft deleted; hanya developer yang dapat menulis deleted_at.'
}

Table report_status_history {
  id bigint [pk, increment]
  report_id uuid [not null, ref: > reports.id]
  from_status_id uuid [ref: > status_definitions.id]
  to_status_id uuid [not null, ref: > status_definitions.id]
  actor_id uuid [ref: > profiles.id]
  note text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (report_id, created_at) [name: 'idx_status_history_report']
    (actor_id, created_at) [name: 'idx_status_history_actor']
  }

  Note: 'Append-only. Trigger melarang UPDATE dan DELETE. Sistem menolak resolved/closed tanpa note.'
}

Table attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  report_id uuid [not null, ref: > reports.id]
  kind attachment_kind [not null]
  storage_path text [not null, unique, note: 'Path di bucket privat report-photos']
  mime_type varchar(60) [not null, note: 'image/jpeg, image/png, image/webp']
  byte_size integer [not null, note: 'check 1..5242880']
  width integer
  height integer
  checksum_sha256 char(64)
  sort_order smallint [not null, default: 0]
  uploaded_by uuid [not null, ref: > profiles.id]
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (report_id, kind, sort_order) [name: 'idx_attachments_report_kind']
  }

  Note: 'Metadata EXIF dihapus sebelum unggah oleh route handler. URL akses selalu signed URL berumur pendek. RLS: mengikuti akses laporan induk.'
}

Table inspections {
  id uuid [pk, default: `gen_random_uuid()`]
  report_id uuid [not null, ref: > reports.id]
  inspector_id uuid [not null, ref: > profiles.id]
  findings varchar(2000) [not null]
  inspected_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (report_id, inspected_at) [name: 'idx_inspections_report']
  }

  Note: 'Hasil inspeksi lapangan. Tidak dapat dihapus; koreksi dicatat sebagai inspeksi baru. RLS: admin RT dan developer.'
}

Table comments {
  id uuid [pk, default: `gen_random_uuid()`]
  report_id uuid [not null, ref: > reports.id]
  author_id uuid [not null, ref: > profiles.id]
  body varchar(2000) [not null]
  moderation_status moderation_status [not null, default: 'visible']
  moderated_by uuid [ref: > profiles.id]
  moderated_at timestamptz
  moderation_reason varchar(300)
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (report_id, created_at) [name: 'idx_comments_report']
  }

  Note: 'P1. Komentar tidak mengubah data inti laporan. RLS: penulis dan admin RT; komentar hidden/removed tidak tampil ke warga.'
}

Table assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  report_id uuid [not null, ref: > reports.id]
  assignee_id uuid [not null, ref: > memberships.id]
  assigned_by uuid [not null, ref: > profiles.id]
  title varchar(120) [not null]
  note varchar(500)
  status assignment_status [not null, default: 'assigned']
  due_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (report_id, status) [name: 'idx_assignments_report']
    (assignee_id, status) [name: 'idx_assignments_assignee']
  }

  Note: 'P2. Petugas hanya melihat penugasan miliknya. RLS ketat per assignee_id.'
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  recipient_id uuid [not null, ref: > profiles.id]
  rt_id uuid [not null, ref: > rts.id]
  type notification_type [not null]
  report_id uuid [ref: > reports.id]
  title varchar(140) [not null]
  body varchar(300) [not null]
  dedupe_key varchar(160) [not null, note: 'Mencegah notifikasi ganda dari retry']
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (recipient_id, read_at, created_at) [name: 'idx_notifications_recipient']
    (recipient_id, dedupe_key) [unique, name: 'uq_notifications_dedupe']
  }

  Note: 'Pusat notifikasi internal adalah sumber utama. read_at null berarti belum dibaca. RLS: penerima saja.'
}

Table audit_logs {
  id bigint [pk, increment]
  rt_id uuid [ref: > rts.id]
  actor_id uuid [ref: > profiles.id]
  actor_role varchar(20) [not null]
  action varchar(80) [not null, note: 'Contoh: report.soft_delete, membership.approve']
  entity_type varchar(40) [not null]
  entity_id uuid
  before_state jsonb
  after_state jsonb
  reason varchar(500)
  request_id varchar(64)
  ip_hash char(64) [note: 'Hash, bukan IP mentah']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (rt_id, created_at) [name: 'idx_audit_rt_created']
    (actor_id, created_at) [name: 'idx_audit_actor']
    (action, created_at) [name: 'idx_audit_action']
    (entity_type, entity_id) [name: 'idx_audit_entity']
  }

  Note: 'Append-only. Trigger melarang UPDATE dan DELETE untuk semua role termasuk service_role. Hanya developer yang membaca lintas RT.'
}

Table platform_settings {
  key varchar(80) [pk]
  value jsonb [not null]
  updated_by uuid [ref: > profiles.id]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Konfigurasi platform. RLS: hanya developer. Tidak menyimpan rahasia; rahasia ada di environment.'
}

Table idempotency_keys {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > profiles.id]
  endpoint varchar(120) [not null]
  key varchar(80) [not null]
  request_hash char(64) [not null]
  status_code smallint
  response_body jsonb
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, default: `now() + interval '24 hours'`]

  indexes {
    (user_id, endpoint, key) [unique, name: 'uq_idempotency_user_endpoint_key']
    (expires_at) [name: 'idx_idempotency_expires']
  }

  Note: 'Mencegah laporan atau unggahan ganda saat klik berulang dan retry jaringan. Dibersihkan job harian.'
}

Table rate_limit_counters {
  id bigint [pk, increment]
  bucket varchar(80) [not null, note: 'Contoh: report.create, membership.join']
  subject_id uuid [not null]
  window_start timestamptz [not null]
  count integer [not null, default: 0]

  indexes {
    (bucket, subject_id, window_start) [unique, name: 'uq_rate_limit_window']
  }

  Note: 'Rate limit sederhana berbasis Postgres untuk pilot. Bukan pengganti WAF.'
}

// ===== Views (security_invoker = true) =====

Table v_reports_feed {
  id uuid [pk]
  public_no varchar(24)
  rt_id uuid
  title varchar(120)
  description varchar(2000)
  category_name varchar(60)
  status_group report_status_group
  status_label varchar(40)
  status_color char(7)
  location_text varchar(200)
  latitude_approx numeric(6,3)
  longitude_approx numeric(6,3)
  photo_count integer
  created_at timestamptz
  updated_at timestamptz

  Note: 'View untuk warga. Tidak memuat reporter_id, koordinat presisi, atau data kontak. RLS tabel dasar tetap berlaku.'
}

Table v_report_timeline {
  id bigint [pk]
  report_id uuid
  from_label varchar(40)
  to_label varchar(40)
  to_group report_status_group
  actor_display_name varchar(80)
  note text
  created_at timestamptz

  Note: 'View timeline publik. actor_display_name menjadi nama admin atau "Warga" untuk pelapor agar identitas tidak bocor.'
}

Table v_rt_activity {
  id bigint [pk]
  rt_id uuid
  actor_display_name varchar(80)
  action varchar(80)
  entity_type varchar(40)
  entity_id uuid
  reason varchar(500)
  created_at timestamptz

  Note: 'View aktivitas RT untuk admin. Hanya action yang relevan operasional RT, tanpa before_state/after_state dan tanpa ip_hash. Developer tetap memakai audit_logs.'
}

// ===== Relasi lintas skema =====

Ref: profiles.id > auth.users.id
